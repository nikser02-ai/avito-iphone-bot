# --- Telegram ---
BOT_TOKEN=123456:ABC-YOUR-TOKEN
ADMIN_ID=0

# --- Регион поиска (Москва + Московская область) ---
# id резолвятся автоматически через API Авито; здесь — фоллбэк
AVITO_LOCATION_IDS=637640,637780
AVITO_CATEGORY_ID=84

# --- Бюджет по умолчанию, рубли ---
PRICE_MIN=10000
PRICE_MAX=150000

# --- Сколько процентов ниже медианы считаем находкой ---
MIN_DISCOUNT=0.15
# Дешевле этой доли от медианы — это приманка, а не сделка
SCAM_FLOOR=0.45
# Минимум объявлений по связке модель+память, чтобы медиане можно было верить
MIN_SAMPLE=8
# Минимальное состояние аккумулятора, % (0 = не фильтровать)
MIN_BATTERY=85

# --- Темп опроса ---
POLL_INTERVAL=180
PAGES_PER_SWEEP=3
BACKFILL_PAGES=15
REQUESTS_PER_MINUTE=20

# --- Сеть ---
# Без российского IP Авито отдаёт 403. Прокси или RU VPS обязательны.
# PROXY=http://user:pass@host:port
PROXY=
AVITO_API_KEY=af0deccbgcgidddjgnvljitntccdduijhdinfgjgfjir

DB_PATH=avito.db
LOG_LEVEL=INFO

# --- Второй источник: письма Авито о новых объявлениях ---
# Работает даже когда антибот режет прямой опрос: Авито присылает письма сам.
# Для Gmail нужен пароль приложения, обычный пароль аккаунта не подойдёт.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SENDER=avito.ru
